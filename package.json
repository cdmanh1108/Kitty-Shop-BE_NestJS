{
  "name": "rental-shop-backend",
  "version": "1.0.0",
  "description": "Production-oriented NestJS backend for a clothing rental shop admin platform.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10"
  },
  "scripts": {
    "i": "npm install --no-audit --no-fund",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,prisma,scripts,test}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm run test:unit",
    "test:unit": "jest --testPathIgnorePatterns=\"test/(integration|e2e)/\" --maxWorkers=2",
    "test:integration": "jest --config jest.db.config.cjs test/integration --runInBand",
    "test:e2e": "jest --config jest.db.config.cjs test/e2e --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --config jest.db.config.cjs --coverage --runInBand",
    "quality": "npm run lint && npm run test && npm run build && npm run openapi:export",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "openapi:export": "ts-node -r tsconfig-paths/register scripts/export-openapi.ts",
    "bootstrap": "node scripts/bootstrap.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit --pretty false",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:db:migrate": "ts-node -r tsconfig-paths/register scripts/migrate-test-database.ts",
    "import:legacy-catalog": "ts-node -r tsconfig-paths/register scripts/import-legacy-catalog.ts",
    "media:sync-storage": "ts-node -r tsconfig-paths/register scripts/sync-product-media-storage.ts",
    "object-storage:check": "ts-node -r tsconfig-paths/register scripts/check-object-storage.ts"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1130.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.34.1",
    "@typescript-eslint/parser": "8.34.1",
    "eslint": "9.29.0",
    "eslint-config-prettier": "10.1.5",
    "jest": "29.7.0",
    "prettier": "3.5.3",
    "prisma": "6.19.3",
    "source-map-support": "0.5.21",
    "supertest": "7.1.1",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1"
  }
}
