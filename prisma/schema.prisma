generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(255)
  legalName    String?  @map("legal_name") @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  email        String?  @db.VarChar(255)
  currency     String   @default("VND") @db.Char(3)
  timezone     String   @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  logoUrl      String?  @map("logo_url") @db.Text
  primaryColor String?  @map("primary_color") @db.VarChar(20)
  status       String   @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  locations              ShopLocation[]
  members                ShopMember[]
  roles                  Role[]
  customers              Customer[]
  tags                   Tag[]
  categories             Category[]
  sizes                  Size[]
  colors                 Color[]
  products               Product[]
  variants               ProductVariant[]
  media                  ProductMedia[]
  inventoryItems         InventoryItem[]
  rentalRates            RentalRate[]
  rentalOrders           RentalOrder[]
  loyaltyEntries         CustomerLoyaltyEntry[]
  rentalOrderItems       RentalOrderItem[]
  rentalAllocations      RentalItemAllocation[]
  rentalCharges          RentalOrderCharge[]
  orderStatusHistory     RentalOrderStatusHistory[]
  inventoryStatusHistory InventoryStatusHistory[]
  inventoryServices      InventoryServiceRecord[]
  paymentTransactions    PaymentTransaction[]
  expenseCategories      ExpenseCategory[]
  expenses               Expense[]
  deliveries             DeliveryJob[]
  reminders              Reminder[]
  notificationLogs       NotificationLog[]
  settings               AppSetting[]
  auditLogs              AuditLog[]
  outboxEvents           OutboxEvent[]
  idempotencyRecords     IdempotencyRecord[]

  @@map("shops")
}

model ShopLocation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  phone       String?  @db.VarChar(30)
  addressLine String?  @map("address_line") @db.Text
  ward        String?  @db.VarChar(100)
  district    String?  @db.VarChar(100)
  city        String?  @db.VarChar(100)
  province    String?  @db.VarChar(100)
  country     String   @default("VN") @db.Char(2)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  isPrimary   Boolean  @default(false) @map("is_primary")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  rentalOrders   RentalOrder[]

  @@unique([shopId, code])
  @@index([shopId, isActive])
  @@map("shop_locations")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String?   @unique @db.VarChar(255)
  phone        String?   @db.VarChar(30)
  passwordHash String?   @map("password_hash") @db.Text
  fullName     String    @map("full_name") @db.VarChar(255)
  avatarUrl    String?   @map("avatar_url") @db.Text
  status       String    @default("ACTIVE") @db.VarChar(20)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships   ShopMember[]
  refreshTokens RefreshToken[]

  @@index([phone])
  @@map("users")
}

model ShopMember {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  employeeCode String?  @map("employee_code") @db.VarChar(50)
  displayName  String   @map("display_name") @db.VarChar(255)
  status       String   @default("ACTIVE") @db.VarChar(20)
  joinedAt     DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberRoles   MemberRole[]
  refreshTokens RefreshToken[]

  @@unique([shopId, userId])
  @@unique([shopId, employeeCode])
  @@index([userId, status])
  @@map("shop_members")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId      String?  @map("shop_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop            Shop?            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  memberRoles     MemberRole[]
  rolePermissions RolePermission[]

  @@unique([shopId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model MemberRole {
  memberId   String   @map("member_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  member ShopMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("member_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  memberId  String    @map("member_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent") @db.Text
  ipAddress String?   @map("ip_address") @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  member ShopMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Customer {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId          String    @map("shop_id") @db.Uuid
  customerCode    String    @map("customer_code") @db.VarChar(50)
  fullName        String    @map("full_name") @db.VarChar(255)
  phone           String    @db.VarChar(30)
  normalizedPhone String    @map("normalized_phone") @db.VarChar(30)
  email           String?   @db.VarChar(255)
  facebook        String?   @db.Text
  zalo            String?   @db.Text
  birthday        DateTime? @db.Date
  gender          String?   @db.VarChar(30)
  customerType    String    @default("NORMAL") @map("customer_type") @db.VarChar(30)
  status          String    @default("ACTIVE") @db.VarChar(20)
  source          String?   @db.VarChar(50)
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)

  shop                Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  addresses           CustomerAddress[]
  notes               CustomerNote[]
  tags                CustomerTag[]
  rentalOrders        RentalOrder[]
  loyaltyEntries      CustomerLoyaltyEntry[]
  paymentTransactions PaymentTransaction[]
  reminders           Reminder[]
  notificationLogs    NotificationLog[]

  @@unique([shopId, customerCode])
  @@unique([shopId, normalizedPhone])
  @@index([shopId, fullName])
  @@index([shopId, status])
  @@map("customers")
}

model CustomerAddress {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  label         String?  @db.VarChar(100)
  recipientName String?  @map("recipient_name") @db.VarChar(255)
  phone         String?  @db.VarChar(30)
  addressLine   String   @map("address_line") @db.Text
  ward          String?  @db.VarChar(100)
  district      String?  @db.VarChar(100)
  city          String?  @db.VarChar(100)
  province      String?  @db.VarChar(100)
  country       String   @default("VN") @db.Char(2)
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

model CustomerNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  content    String   @db.Text
  isPinned   Boolean  @default(false) @map("is_pinned")
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isPinned])
  @@map("customer_notes")
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String   @db.VarChar(100)
  color     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop      Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customers CustomerTag[]

  @@unique([shopId, name])
  @@map("tags")
}

model CustomerTag {
  customerId String @map("customer_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tags")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  slug        String?  @db.VarChar(255)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop     Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([shopId, code])
  @@index([shopId, isActive, sortOrder])
  @@map("categories")
}

model Size {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([shopId, code])
  @@map("sizes")
}

model Color {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(100)
  hexColor  String?  @map("hex_color") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([shopId, code])
  @@map("colors")
}

model Product {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId               String    @map("shop_id") @db.Uuid
  categoryId           String    @map("category_id") @db.Uuid
  code                 String    @db.VarChar(50)
  name                 String    @db.VarChar(255)
  slug                 String?   @db.VarChar(255)
  description          String?   @db.Text
  defaultDepositAmount Decimal   @default(0) @map("default_deposit_amount") @db.Decimal(18, 2)
  replacementValue     Decimal?  @map("replacement_value") @db.Decimal(18, 2)
  facebookPostUrl      String?   @map("facebook_post_url") @db.Text
  currency             String    @default("VND") @db.Char(3)
  status               String    @default("ACTIVE") @db.VarChar(20)
  isRentable           Boolean   @default(true) @map("is_rentable")
  isPublic             Boolean   @default(false) @map("is_public")
  metadata             Json?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz(6)

  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  media       ProductMedia[]
  rentalRates RentalRate[]
  orderItems  RentalOrderItem[]

  @@unique([shopId, code])
  @@index([shopId, categoryId, status])
  @@index([shopId, name])
  @@map("products")
}

/// SQL partial unique index: unarchived (productId, sizeId, colorId), NULLS NOT DISTINCT.
model ProductVariant {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId                String    @map("shop_id") @db.Uuid
  productId             String    @map("product_id") @db.Uuid
  variantCode           String    @map("variant_code") @db.VarChar(100)
  sizeId                String?   @map("size_id") @db.Uuid
  colorId               String?   @map("color_id") @db.Uuid
  depositAmountOverride Decimal?  @map("deposit_amount_override") @db.Decimal(18, 2)
  status                String    @default("ACTIVE") @db.VarChar(20)
  metadata              Json?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(6)

  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  size           Size?             @relation(fields: [sizeId], references: [id], onDelete: SetNull)
  color          Color?            @relation(fields: [colorId], references: [id], onDelete: SetNull)
  inventoryItems InventoryItem[]
  rentalRates    RentalRate[]
  media          ProductMedia[]
  orderItems     RentalOrderItem[]

  @@unique([shopId, variantCode])
  @@index([productId, status])
  @@map("product_variants")
}

/// SQL partial unique index: at most one isPrimary row per product.
model ProductMedia {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId     String   @map("shop_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  mediaType  String   @default("IMAGE") @map("media_type") @db.VarChar(20)
  // Canonical for managed objects; url retains the external migration source.
  storageKey String?  @map("storage_key") @db.Text
  url        String   @db.Text
  altText    String?  @map("alt_text") @db.VarChar(255)
  sortOrder  Int      @default(0) @map("sort_order")
  isPrimary  Boolean  @default(false) @map("is_primary")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop    Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_media")
}

model InventoryItem {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId           String    @map("shop_id") @db.Uuid
  variantId        String    @map("variant_id") @db.Uuid
  locationId       String?   @map("location_id") @db.Uuid
  sku              String    @db.VarChar(100)
  barcode          String?   @db.VarChar(100)
  /// Operational condition only; SQL CHECK in 202609110003. Occupancy is derived from allocations.
  currentStatus    String    @default("AVAILABLE") @map("current_status") @db.VarChar(30)
  condition        String    @default("GOOD") @db.VarChar(30)
  purchasePrice    Decimal?  @map("purchase_price") @db.Decimal(18, 2)
  purchaseDate     DateTime? @map("purchase_date") @db.Date
  acquiredFrom     String?   @map("acquired_from") @db.VarChar(255)
  totalRentalCount Int       @default(0) @map("total_rental_count")
  lastRentedAt     DateTime? @map("last_rented_at") @db.Timestamptz(6)
  notes            String?   @db.Text
  metadata         Json?
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)

  shop           Shop                     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  variant        ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location       ShopLocation?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  allocations    RentalItemAllocation[]
  statusHistory  InventoryStatusHistory[]
  serviceRecords InventoryServiceRecord[]
  expenses       Expense[]

  @@unique([shopId, sku])
  @@unique([shopId, barcode])
  @@index([shopId, currentStatus])
  @@index([variantId, isActive])
  @@map("inventory_items")
}

/// SQL partial indexes in 202609110004: one active rate per shop/product/variant/duration.
/// NULL variantId has its own product-level index; inactive history is unrestricted.
model RentalRate {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId       String    @map("shop_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  variantId    String?   @map("variant_id") @db.Uuid
  durationDays Int       @map("duration_days")
  price        Decimal   @db.Decimal(18, 2)
  currency     String    @default("VND") @db.Char(3)
  validFrom    DateTime? @map("valid_from") @db.Date
  validUntil   DateTime? @map("valid_until") @db.Date
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop    Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, variantId, durationDays, isActive])
  @@map("rental_rates")
}

model RentalOrder {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId               String    @map("shop_id") @db.Uuid
  orderNumber          String    @map("order_number") @db.VarChar(50)
  customerId           String    @map("customer_id") @db.Uuid
  locationId           String?   @map("location_id") @db.Uuid
  rentalStartAt        DateTime  @map("rental_start_at") @db.Timestamptz(6)
  rentalEndAt          DateTime  @map("rental_end_at") @db.Timestamptz(6)
  actualStartedAt      DateTime? @map("actual_started_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz(6)
  status               String    @default("RESERVED") @db.VarChar(30)
  paymentStatus        String    @default("UNPAID") @map("payment_status") @db.VarChar(30)
  depositStatus        String    @default("PENDING") @map("deposit_status") @db.VarChar(30)
  currency             String    @default("VND") @db.Char(3)
  rentalSubtotal       Decimal   @default(0) @map("rental_subtotal") @db.Decimal(18, 2)
  chargesTotal         Decimal   @default(0) @map("charges_total") @db.Decimal(18, 2)
  discountTotal        Decimal   @default(0) @map("discount_total") @db.Decimal(18, 2)
  depositRequired      Decimal   @default(0) @map("deposit_required") @db.Decimal(18, 2)
  collateralMethod     String    @default("CASH") @map("collateral_method") @db.VarChar(20)
  documentType         String?   @map("document_type") @db.VarChar(20)
  collateralStatus     String    @default("REQUIRED") @map("collateral_status") @db.VarChar(20)
  collateralReceivedAt DateTime? @map("collateral_received_at") @db.Timestamptz(6)
  collateralReturnedAt DateTime? @map("collateral_returned_at") @db.Timestamptz(6)
  grandTotal           Decimal   @default(0) @map("grand_total") @db.Decimal(18, 2)
  note                 String?   @db.Text
  internalNote         String?   @map("internal_note") @db.Text
  metadata             Json?
  createdBy            String?   @map("created_by") @db.Uuid
  updatedBy            String?   @map("updated_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop                   Shop                       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer               Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  location               ShopLocation?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items                  RentalOrderItem[]
