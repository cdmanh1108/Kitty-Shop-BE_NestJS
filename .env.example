NODE_ENV=development
# fatal | error | warn | log | debug | verbose (production default: log, development: debug)
LOG_LEVEL=log
PORT=3007
API_PREFIX=api/v1
APP_NAME=Rental Shop API
APP_URL=http://localhost:3007
# Comma-separated list of allowed origins. Wildcard "*" is prohibited in production with credentials.
CORS_ORIGINS=http://localhost:3000
# Set to true only if deployed behind a trusted single-hop reverse proxy
TRUST_PROXY=false
# Swagger UI / OpenAPI HTTP exposure: true by default in dev/test, false by default in production
SWAGGER_ENABLED=true

# Database connection URL (required in production; placeholder must not be used)
DATABASE_URL=postgresql://rental:rental@localhost:5432/rental_shop?schema=public
DB_AUTO_START=true

# JWT Signing Secret (required; must be at least 32 characters; weak/placeholder secrets rejected in production)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=300

# Development only. Production startup rejects bypass=true. SMS adapter is not installed yet.
AUTH_OTP_BYPASS_ENABLED=false
AUTH_OTP_BYPASS_CODE=123456
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_HASH_SECRET=replace-with-separate-otp-hash-secret-at-least-32-characters
WEB_JWT_ACCESS_SECRET=replace-with-separate-web-jwt-secret-at-least-32-characters
WEB_JWT_ACCESS_TTL_SECONDS=900
WEB_REFRESH_TOKEN_TTL_DAYS=30

DEFAULT_SHOP_CODE=MAIN
DEFAULT_SHOP_NAME=Rental Shop
DEFAULT_ADMIN_EMAIL=admin@example.com
# Initial seed password only; must be changed for production seed
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_NAME=Shop Owner

# S3-Compatible Object Storage (e.g., Cloudflare R2, AWS S3, MinIO)
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
# Separate bucket with public access disabled; required only for confirmation evidence.
OBJECT_STORAGE_PRIVATE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
