NODE_ENV=development
# fatal | error | warn | log | debug | verbose (production default: log)
LOG_LEVEL=log
PORT=3000
API_PREFIX=api/v1
APP_NAME=Rental Shop API
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
TRUST_PROXY=false
SWAGGER_ENABLED=true

DATABASE_URL=postgresql://rental:rental@localhost:5432/rental_shop?schema=public
DB_AUTO_START=true

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=300

DEFAULT_SHOP_CODE=MAIN
DEFAULT_SHOP_NAME=Rental Shop
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_NAME=Shop Owner
