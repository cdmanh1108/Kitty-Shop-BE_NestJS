# Copy to .env on the server. This file is intentionally safe to commit.
BACKEND_IMAGE=docker.io/your-dockerhub-user/kitty-be
BACKEND_MIGRATOR_IMAGE=docker.io/your-dockerhub-user/kitty-be-migrate
IMAGE_TAG=latest
BACKEND_BIND_ADDRESS=127.0.0.1

NODE_ENV=production
LOG_LEVEL=warn
PORT=3000
API_PREFIX=api/v1
APP_NAME=Rental Shop API
APP_URL=https://api.example.com
CORS_ORIGINS=https://www.example.com
TRUST_PROXY=true
SWAGGER_ENABLED=false
DATABASE_URL=postgresql://replace-with-managed-db-credentials@private-db.example.com:5432/rental_shop?schema=public

# Use three distinct random values of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-strong-unique-secret
WEB_JWT_ACCESS_SECRET=replace-with-a-different-strong-unique-secret
AUTH_OTP_HASH_SECRET=replace-with-a-third-strong-unique-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
WEB_JWT_ACCESS_TTL_SECONDS=900
WEB_REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=300
AUTH_OTP_BYPASS_ENABLED=false
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60

DEFAULT_SHOP_CODE=MAIN
DEFAULT_SHOP_NAME=Rental Shop
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEFAULT_ADMIN_NAME=Shop Owner

# Leave all of these blank when object storage is not used.
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PRIVATE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
